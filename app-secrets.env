# Map GCP Secret Manager secrets to Cloud Run environment variables.
# Format: ENV_VAR_NAME=SECRET_NAME:version
# Example:
#   OPENAI_API_KEY=OPENAI_API_KEY:latest
#   DATABASE_URL=MY_APP_DB_URL:latest
#
# To create a secret:
#   gcloud secrets create SECRET_NAME --data-file=- <<< "your-secret-value"
#
# Leave this file empty (comments only) if your app has no secrets.
